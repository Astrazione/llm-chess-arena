# Необязательный файл: docker compose up --build работает и без .env.
FRONTEND_PORT=5173
BACKEND_PORT=3000
LOG_LEVEL=info
# Polling нужен для bind mounts Docker Desktop/WSL2; на Linux можно отключить.
WATCH_USE_POLLING=true
WATCH_INTERVAL_MS=500

# Необязательный NVIDIA runtime, включается только --profile nvidia.
# Версия подтверждена release notes и manifest; CUDA/PyTorch берутся из образа.
VLLM_IMAGE=vllm/vllm-openai:v0.32.0
VLLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_MODEL_REVISION=main
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_NUM_SEQS=1
VLLM_PORT=8000
# Токен Hugging Face только inference-контейнеру; публичной модели не нужен.
HF_TOKEN=

# Ключи только для backend. Наличие ключа не запускает запросы автоматически.
# Передаются только backend. Никогда не называйте секреты VITE_*.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY_1=
LLM_API_KEY_2=
# Любые поставщики: привязка server env к точному Base URL, без /chat/completions.
# Оставьте пустым, если используются только Mock или API без авторизации.
LLM_ENDPOINTS_JSON=
# Дополнительные точные Base URL, которым разрешено read-only обнаружение моделей.
# Адреса стандартных локальных шаблонов и профилей ключей разрешены автоматически.
LLM_DISCOVERY_URLS_JSON=
# LLM_DISCOVERY_URLS_JSON='["https://inference.example/v1","http://host.docker.internal:9000/v1"]'
# Пример (раскомментировать и заполнить ключи выше):
# LLM_ENDPOINTS_JSON='{"cloud":{"baseUrl":"https://provider.example/v1","apiKeyEnv":"LLM_API_KEY_1"},"local":{"baseUrl":"http://host.docker.internal:8000/v1","apiKeyEnv":"LLM_API_KEY_2"}}'
